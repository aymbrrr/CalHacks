# Redis Cloud (sponsor) — must have RediSearch / vector indexing enabled.
# Format: redis://default:<password>@<host>:<port>  (or rediss:// for TLS)
REDIS_URL=redis://default:password@localhost:6379

# OpenAI — used for embeddings (text-embedding-3-small) and redundant.llm() executions.
OPENAI_API_KEY=sk-...

# Optional overrides
# REDUNDANT_SIM_THRESHOLD=0.86
# REDUNDANT_DEFAULT_MODEL=gpt-4o-mini
